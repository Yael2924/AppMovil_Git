<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.LoginGitHub" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Tema de Splash para Android 12+ y posterior que elimina el icono predeterminado de Android -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0F172A</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.LoginGitHub</item>
    </style>
</resources>
